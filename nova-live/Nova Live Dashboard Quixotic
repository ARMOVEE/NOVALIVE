      $("#autoH1").addEventListener("change", function(){
        renderAutoH1();
        showToast(this.checked ? "Notifikasi otomatis H-1 diaktifkan (simulasi demo)." : "Notifikasi otomatis H-1 dimatikan (simulasi demo).");
        logAct((this.checked ? "mengaktifkan" : "mematikan") + " notifikasi otomatis H-1");
      });

      /* ==================== STOK TIKET ==================== */
      var STOCK = {};
      function stockOf(ev){
        if(STOCK[ev.id]) return STOCK[ev.id];
        var tiers = ev.cat === "Musik" ? ["Festival","CAT 1","VIP"] : ev.cat === "Olahraga" ? ["Reguler","Tribune","VIP Courtside"] : ev.cat === "Workshop" ? ["Reguler","Reguler + Kit"] : ["Reguler","VIP"];
        var w = [0.55, 0.3, 0.15];
        var usedT = 0, usedS = 0;
        STOCK[ev.id] = tiers.map(function(n, i){
          var total, sold;
          if(i === tiers.length - 1){ total = Math.max(10, ev.cap - usedT); sold = Math.max(0, ev.sold - usedS); }
          else { total = Math.round(ev.cap * w[i]); sold = Math.min(total, Math.round(ev.sold * w[i])); usedT += total; usedS += sold; }
          return {name:n, total:total, sold:sold};
        });
        return STOCK[ev.id];
      }
      function renderStock(){
        $("#stockList").innerHTML = EVENTS.map(function(ev){
          var tiers = stockOf(ev);
          var rows = tiers.map(function(t, i){
            var sisa = t.total - t.sold;
            var pctLeft = t.total ? Math.round(sisa / t.total * 100) : 0;
            var low = t.total > 0 && pctLeft <= 15;
            return '<tr><td data-label="Kategori Tiket">' + esc(t.name) + '</td><td data-label="Terjual">' + fmt(t.sold) + '</td><td data-label="Sisa Stok"><b>' + fmt(sisa) + '</b> <small style="color:var(--muted)">/ ' + fmt(t.total) + '</small>' + (low ? ' <span class="stock-warn">Hampir Habis</span>' : "") + '<div class="progress" style="max-width:170px"><i style="width:' + (t.total ? Math.round(t.sold / t.total * 100) : 0) + '%"></i></div></td>' +
              '<td data-label="Ubah Total Stok" class="no-label"><div class="stock-edit"><input type="number" min="0" value="' + t.total + '" data-stock-inp="' + ev.id + ':' + i + '" aria-label="Total stok ' + esc(t.name) + '"/><button class="mini-btn" type="button" data-stock-save="' + ev.id + ':' + i + '">Simpan</button></div></td></tr>';
          }).join("");
          return '<div class="card" style="margin-bottom:18px"><div class="table-tools"><h2>' + esc(ev.name) + '</h2><span class="ev-sub">' + esc(ev.city) + ' · ' + ev.dateLabel + '</span><span class="badge ' + STATUS_EV[ev.status].cls + '" style="margin-left:auto">' + STATUS_EV[ev.status].label + '</span></div><div class="tbl-scroll"><table class="tbl" style="min-width:620px"><thead><tr><th scope="col">Kategori Tiket</th><th scope="col">Terjual</th><th scope="col">Sisa Stok</th><th scope="col">Ubah Total Stok</th></tr></thead><tbody>' + rows + '</tbody></table></div></div>';
        }).join("");
      }
      $("#stockList").addEventListener("click", function(e){
        var b = e.target.closest("[data-stock-save]"); if(!b) return;
        var key = b.getAttribute("data-stock-save");
        var parts = key.split(":"), ev = evById(parts[0]), i = parseInt(parts[1], 10);
        var inp = $('[data-stock-inp="' + key + '"]');
        var val = parseInt(inp.value, 10);
        if(isNaN(val) || val < 0){ showToast("Masukkan angka stok yang valid."); return; }
        var t = stockOf(ev)[i];
        if(val < t.sold){ showToast("Total stok tidak boleh lebih kecil dari tiket yang sudah terjual (" + fmt(t.sold) + ")."); return; }
        var old = t.total; t.total = val;
        renderStock();
        showToast('Stok ' + esc(t.name) + ' untuk <em>' + esc(ev.name) + '</em> diubah menjadi ' + fmt(val) + ' tiket.');
        logAct('mengubah stok ' + t.name + ' "' + ev.name + '" dari ' + fmt(old) + ' menjadi ' + fmt(val) + ' tiket');
      });

      /* ==================== ANALITIK & LAPORAN ==================== */
      var SEARCH_KW = [["tulus konser",1284],["lalala festival",986],["konser jakarta",874],["festival balon bali",642],["nadin amizah bandung",517],["final basket surabaya",433],["midnight jazz",289],["pameran fotografi analog",176]];
      var SEARCH_TREND = {labels:["Rab 11","Kam 12","Jum 13","Sab 14","Min 15","Sen 16","Sel 17"], values:[1240,1385,1290,1620,1480,1715,1590]};
      function renderKw(){
        $("#kwList").innerHTML = SEARCH_KW.map(function(k, i){
          return '<div class="kw-row"><span class="kw-rank">' + (i + 1) + '</span><div style="flex:1;min-width:0"><b style="font-size:14px">“' + esc(k[0]) + '”</b><div class="progress" style="max-width:260px"><i style="width:' + Math.round(k[1] / SEARCH_KW[0][1] * 100) + '%"></i></div></div><b style="font-family:\'Plus Jakarta Sans\',sans-serif">' + fmt(k[1]) + '×</b></div>';
        }).join("");
      }
      function renderTrend(){
        var data = SEARCH_TREND, W = 720, H = 230, padL = 14, padB = 30, padT = 16;
        var max = Math.max.apply(null, data.values) * 1.15, n = data.values.length;
        var slot = (W - padL * 2) / n, bw = Math.min(46, slot * 0.55), base = H - padB, bars = "", labels = "", grid = "";
        [0.25, 0.5, 0.75, 1].forEach(function(f){ var y = padT + (base - padT) * (1 - f); grid += '<line x1="' + padL + '" y1="' + y + '" x2="' + (W - padL) + '" y2="' + y + '" stroke="#E7EBEE" stroke-width="1" stroke-dasharray="3 4"/>'; });
        data.values.forEach(function(v, i){
          var h = (base - padT) * (v / max), x = padL + slot * i + (slot - bw) / 2, y = base - h;
          bars += '<rect x="' + x.toFixed(1) + '" y="' + y.toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + h.toFixed(1) + '" rx="6" fill="' + (i === n - 1 ? "#D4B475" : "#23649A") + '" opacity="' + (i === n - 1 ? "1" : "0.85") + '"><title>' + data.labels[i] + ': ' + fmt(v) + ' pencarian</title></rect>';
          bars += '<text x="' + (padL + slot * i + slot / 2).toFixed(1) + '" y="' + (y - 7).toFixed(1) + '" text-anchor="middle" font-size="11.5" font-weight="700" fill="#14232F" font-family="Inter,sans-serif">' + fmt(v) + '</text>';
          labels += '<text x="' + (padL + slot * i + slot / 2).toFixed(1) + '" y="' + (H - 8) + '" text-anchor="middle" font-size="11.5" fill="#7A8794" font-family="Inter,sans-serif">' + data.labels[i] + '</text>';
        });
        $("#trendChart").innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" role="img" aria-label="Grafik tren pencarian homepage">' + grid + bars + labels + '<line x1="' + padL + '" y1="' + base + '" x2="' + (W - padL) + '" y2="' + base + '" stroke="#E7EBEE" stroke-width="1.5"/></svg>';
      }
      function hbars(map){
        var keys = Object.keys(map).sort(function(a, b){ return map[b] - map[a]; });
        var max = Math.max.apply(null, keys.map(function(k){ return map[k]; })) || 1;
        return keys.map(function(k){
          return '<div class="hbar-row"><span>' + esc(k) + '</span><div class="hbar-track"><div class="hbar-fill" style="width:' + Math.round(map[k] / max * 100) + '%"></div></div><b>' + fmt(map[k]) + '</b></div>';
        }).join("");
      }
      function renderReports(){
        var byCity = {}, byCat = {};
        EVENTS.forEach(function(e){
          byCity[e.city] = (byCity[e.city] || 0) + e.sold;
          byCat[e.cat] = (byCat[e.cat] || 0) + e.sold;
        });
        var cr = $("#cityReport"), kr = $("#catReport");
        if(cr) cr.innerHTML = hbars(byCity) + '<p style="color:var(--muted);font-size:12.5px;margin:12px 0 0">Angka = total tiket terjual per kota dari event demo.</p>';
        if(kr) kr.innerHTML = hbars(byCat) + '<p style="color:var(--muted);font-size:12.5px;margin:12px 0 0">Angka = total tiket terjual per kategori dari event demo.</p>';
      }

      /* ==================== INIT ==================== */
      $("#catIcon").innerHTML = Object.keys(CAT_ICONS).map(function(k){ return '<option value="' + k + '">' + CAT_ICON_LABEL[k] + '</option>'; }).join("");
      $("#etOrder").innerHTML = ORDERS.filter(function(o){ return o.status === "lunas"; }).map(function(o){ return '<option value="' + o.inv + '">' + o.inv + ' — ' + esc(o.buyer) + ' · ' + esc(o.event) + '</option>'; }).join("");
      syncCatSelect();
      syncCitySelect();
      syncNotifTargets();
      renderEvents();
      renderOrders();
      renderCiEvents();
      renderCheckin();
      renderRefunds();
      renderCategories();
      renderCities();
      renderBanners();
      renderTampilan();
      renderEtiket();
      renderNotifHistory();
      renderAutoH1();
      renderStock();
      renderKw();
      renderTrend();
      renderReports();
      renderLog();
      updateBadges();
    </script>
    <script>
      /* Tooltip rail ikon (fixed, tidak terpotong overflow rail) */
      (function(){
        var tip = document.getElementById('railTip');
        var rail = document.getElementById('rail');
        function show(b){
          if(window.innerWidth <= 820) return;
          var r = b.getBoundingClientRect();
          tip.textContent = b.getAttribute('data-tip') || '';
          tip.style.left = (r.right + 12) + 'px';
          tip.style.top = (r.top + r.height / 2) + 'px';
          tip.classList.add('show');
        }
        function hide(){ tip.classList.remove('show'); }
        $$('#rail button[data-tip]').forEach(function(b){
          b.addEventListener('mouseenter', function(){ show(b); });
          b.addEventListener('mouseleave', hide);
          b.addEventListener('click', hide);
          b.addEventListener('focus', function(){ show(b); });
          b.addEventListener('blur', hide);
        });
        rail.addEventListener('scroll', hide, {passive:true});
        window.addEventListener('resize', hide);
      })();
    </script>
    <script>
      /* Animasi logo tiket NOVALIVE (Ticket Intro) — auto-loop 4,2 dtk + jeda 1200ms, klik logo = putar ulang */
      (function(){
        var DURATION = 4.2; // detik
        var PAUSE = 1200;   // jeda antar putaran (ms)

        function clamp(x){ return Math.min(1, Math.max(0, x)); }
        function prog(t, a, b){ return clamp((t - a) / (b - a)); }
        var ease = {
          outCubic: function(x){ return 1 - Math.pow(1 - x, 3); },
          inOutCubic: function(x){ return x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2; },
          outBack: function(x, s){ s = (s == null ? 1.70158 : s); var c = s + 1; return 1 + c * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2); }
        };

        var svg = document.getElementById('nvqTicket');
        if(!svg) return;
        function part(name){ return svg.querySelector('[data-part="' + name + '"]'); }
        var parts = {
          root: part('root'), ribbon: part('ribbon'), dark: part('dark'), light: part('light'), shine: part('shine'),
          dots: Array.prototype.slice.call(svg.querySelectorAll('[data-part="dot"]')),
          ovals: Array.prototype.slice.call(svg.querySelectorAll('[data-part="oval"]'))
        };

        function pop(el, t, t0){
          var cx = +el.getAttribute('data-cx'), cy = +el.getAttribute('data-cy');
          var u = prog(t, t0, t0 + 0.42);
          var s = u <= 0 ? 0 : ease.outBack(u, 2.4);
          el.setAttribute('transform', 'translate(' + cx + ' ' + cy + ') scale(' + Math.max(s, 0.0001) + ')');
        }

        // Satu fungsi murni dari waktu (detik) ke tampilan, jadi bisa diputar, dijeda, atau dicari ke titik mana pun.
        function apply(t){
          var p = 1 + 0.04 * ease.inOutCubic(prog(t, 0.2, DURATION));
          parts.root.setAttribute('transform', 'translate(650 300) scale(' + p + ') translate(-650 -300)');

          // 1. pita emas tergambar
          parts.ribbon.setAttribute('stroke-dashoffset', (1 - ease.inOutCubic(prog(t, 0.25, 1.3))).toFixed(4));

          // 2. tiket biru gelap naik dari kiri bawah
          var u1 = prog(t, 0.6, 1.45), e1 = ease.outCubic(u1);
          parts.dark.setAttribute('transform',
            'translate(' + (450 - 260 * (1 - e1)) + ' ' + (300 + 150 * (1 - e1)) + ') scale(' + (0.86 + 0.14 * e1) + ') translate(-450 -300)');
          parts.dark.setAttribute('opacity', clamp(u1 * 3).toFixed(3));

          // 3. lipatan biru muda terbuka dari sudut kirinya
          var u2 = prog(t, 0.95, 1.85), e2 = ease.outCubic(u2);
          parts.light.setAttribute('transform',
            'translate(' + (678 + 90 * (1 - e2)) + ' ' + (365 - 50 * (1 - e2)) + ') rotate(' + (-16 * (1 - e2)) + ') scale(' + (0.12 + 0.88 * e2) + ' ' + (0.6 + 0.4 * e2) + ') translate(-678 -365)');
          parts.light.setAttribute('opacity', clamp(u2 * 4).toFixed(3));

          // 4. titik-titik muncul satu per satu
          parts.dots.forEach(function(el, i){ pop(el, t, 1.45 + 0.1 * i); });
          parts.ovals.forEach(function(el, i){ pop(el, t, 1.9 + 0.1 * i); });

          // 5. kilau melintas sekali
          var u3 = prog(t, 2.15, 3.0), e3 = ease.inOutCubic(u3);
          parts.shine.setAttribute('transform', 'translate(' + (-250 + e3 * 1850) + ' 0) rotate(20 0 300)');
          parts.shine.setAttribute('opacity', (u3 > 0 && u3 < 1) ? 1 : 0);
        }

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var raf = 0, timer = 0;

        function play(){
          cancelAnimationFrame(raf);
          clearTimeout(timer);
          if(reduceMotion){ apply(DURATION); return; }
          var start = 0;
          apply(0);
          function tick(now){
            if(!start) start = now;
            var t = (now - start) / 1000;
            apply(Math.min(t, DURATION));
            if(t < DURATION){
              raf = requestAnimationFrame(tick);
            } else {
              timer = setTimeout(play, PAUSE); // jeda lalu putar lagi (auto-loop)
            }
          }
          raf = requestAnimationFrame(tick);
        }

        var logoLink = document.getElementById('logoHome');
        if(logoLink) logoLink.addEventListener('click', play);
        window.novaliveTicket = { apply: apply, play: play, DURATION: DURATION };
        play();
      })();
    </script>
