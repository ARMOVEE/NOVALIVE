<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="data:," />
    <title>NOVA LIVE — Dashboard Quixotic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2rem; }
    </style>
    <style>
      :root{
        --navy:#0E3254;
        --navy-2:#15497A;
        --blue:#23649A;
        --sky:#509FC8;
        --bar:#B7D0E2;
        --bar-soft:#CFE0ED;
        --gold:#EAD4A2;
        --gold-deep:#D4B475;
        --gold-dark:#8C6D1F;
        --cream:#F5EFE0;
        --page:#E8EAEC;
        --panel:#F5F6F5;
        --card:#FFFFFF;
        --ink:#14232F;
        --muted:#7A8794;
        --line:#E7EBEE;
        --green:#2E9E5B;
        --green-bg:#E4F4EA;
        --red:#DC2626;
        --red-bg:#FDECEC;
        --radius:22px;
        --shadow:0 1px 2px rgba(14,50,84,.04),0 10px 30px rgba(14,50,84,.05);
      }
      *{box-sizing:border-box}
      html,body{margin:0;padding:0}
      body{
        font-family:'Inter',system-ui,sans-serif;
        background:var(--page);
        color:var(--ink);
        -webkit-font-smoothing:antialiased;
        padding:22px 18px 30px;
      }
      h1,h2,h3,.pj{font-family:'Plus Jakarta Sans','Inter',sans-serif}
      button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
      .frame{
        max-width:1240px;margin:0 auto;
        background:var(--panel);
        border-radius:30px;
        padding:18px 22px 24px;
        box-shadow:0 24px 60px rgba(14,50,84,.10);
      }

      /* ---------- Top bar ---------- */
      .topbar{
        display:flex;align-items:center;gap:18px;
        background:var(--card);
        border-radius:999px;
        padding:10px 12px 10px 20px;
        box-shadow:var(--shadow);
        position:relative;z-index:30;
      }
      .logo{display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--navy);flex:none}
      .logo svg{display:block}
      .logo-ticket{height:40px;width:auto;overflow:visible;cursor:pointer;flex:none}
      .logo-word{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:19px;letter-spacing:.2px;color:var(--navy);white-space:nowrap}
      .logo-word em{font-style:normal;color:var(--gold-deep)}
      .topnav{display:flex;gap:4px;margin:0 auto;background:#F1F3F4;border-radius:999px;padding:4px}
      .topnav button{
        padding:8px 18px;border-radius:999px;font-size:13.5px;font-weight:600;color:#5B6B78;min-height:36px;
        transition:background .15s,color .15s;
      }
      .topnav button:hover{color:var(--navy)}
      .topnav button.active{background:var(--card);color:var(--navy);box-shadow:0 2px 8px rgba(14,50,84,.10)}
      .top-actions{display:flex;align-items:center;gap:6px;flex:none;margin-left:auto}
      .icon-btn{
        width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--navy);
        position:relative;transition:background .15s;flex:none;
      }
      .icon-btn:hover{background:#EEF3F7}
      .icon-btn .dot{position:absolute;top:9px;right:10px;width:8px;height:8px;border-radius:50%;background:var(--gold-deep);border:2px solid #fff}
      .search-wrap{display:flex;align-items:center}
      .search-input{
        width:0;opacity:0;border:none;outline:none;background:#F1F3F4;border-radius:999px;
        font-size:13.5px;font-family:inherit;color:var(--ink);
        transition:width .25s ease,opacity .2s,padding .25s;
        padding:0;min-height:40px;
      }
      .search-wrap.open .search-input{width:170px;opacity:1;padding:0 14px;margin-right:2px}
      .avatar-btn{display:flex;align-items:center;gap:2px;border-radius:999px;padding:2px 4px 2px 2px}
      .avatar-btn:hover{background:#EEF3F7}
      .avatar{
        width:38px;height:38px;border-radius:50%;flex:none;
        background:linear-gradient(135deg,var(--navy-2),var(--navy));
        color:var(--gold);display:grid;place-items:center;
        font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;
        border:2px solid var(--gold);
      }
      .pop{
        position:absolute;top:calc(100% + 10px);right:12px;width:300px;max-width:calc(100vw - 40px);
        background:var(--card);border-radius:18px;box-shadow:0 18px 44px rgba(14,50,84,.16);
        border:1px solid var(--line);padding:10px;display:none;z-index:50;
      }
      .pop.open{display:block}
      .pop h3{margin:6px 8px 8px;font-size:13px;color:var(--navy)}
      .notif{display:flex;gap:10px;padding:9px 8px;border-radius:12px}
      .notif:hover{background:#F4F7F9}
      .notif .n-ico{width:34px;height:34px;border-radius:10px;background:var(--cream);display:grid;place-items:center;flex:none;color:var(--gold-deep)}
      .notif p{margin:0;font-size:12.5px;line-height:1.45;color:var(--ink)}
      .notif span{display:block;color:var(--muted);font-size:11.5px;margin-top:1px}

      /* ---------- Greeting row ---------- */
      .greet{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:26px 4px 20px}
      .greet h1{font-size:clamp(24px,3.4vw,34px);font-weight:600;margin:0;color:#3A4750;letter-spacing:-.3px}
      .greet h1 strong{font-weight:800;color:var(--ink)}
      .greet-actions{margin-left:auto;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
      .range-wrap{position:relative}
      .range-btn{
        display:flex;align-items:center;gap:9px;background:var(--card);border-radius:999px;
        padding:10px 16px;font-size:13px;font-weight:600;color:var(--ink);box-shadow:var(--shadow);min-height:42px;
      }
      .range-btn svg{color:var(--navy)}
      .range-menu{
        position:absolute;top:calc(100% + 8px);right:0;background:var(--card);border:1px solid var(--line);
        border-radius:16px;box-shadow:0 18px 44px rgba(14,50,84,.16);padding:6px;display:none;z-index:40;min-width:230px;
      }
      .range-menu.open{display:block}
      .range-menu button{display:flex;width:100%;text-align:left;padding:9px 12px;border-radius:10px;font-size:13px;font-weight:500;min-height:38px;align-items:center}
      .range-menu button:hover{background:#F4F7F9}
      .range-menu button.sel{background:var(--cream);color:var(--navy);font-weight:700}
      .btn-primary{
        display:flex;align-items:center;gap:8px;background:var(--navy);color:#fff;
        border-radius:999px;padding:10px 20px;font-size:13.5px;font-weight:700;min-height:42px;
        box-shadow:0 10px 22px rgba(14,50,84,.25);transition:background .15s,transform .1s;
        font-family:'Plus Jakarta Sans',sans-serif;
      }
      .btn-primary:hover{background:var(--navy-2)}
      .btn-primary:active{transform:scale(.98)}

      /* ---------- Layout & rail ---------- */
      .layout{display:flex;gap:18px;align-items:flex-start}
      .rail{
        flex:none;width:62px;background:var(--card);border-radius:999px;box-shadow:var(--shadow);
        display:flex;flex-direction:column;align-items:center;padding:12px 0;gap:5px;
        position:sticky;top:16px;max-height:calc(100vh - 32px);overflow-y:auto;scrollbar-width:none;z-index:20;
      }
      .rail::-webkit-scrollbar{display:none}
      .rail button{
        width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#8A97A3;transition:all .15s;position:relative;flex:none;
      }
      .rail button:hover{color:var(--navy);background:#EEF3F7}
      .rail button.active{background:var(--navy);color:var(--gold);box-shadow:0 8px 18px rgba(14,50,84,.28)}
      #railTip{
        position:fixed;z-index:200;background:var(--navy);color:#fff;font-size:12px;font-weight:600;
        padding:6px 11px;border-radius:8px;white-space:nowrap;pointer-events:none;
        opacity:0;transform:translateY(-50%) translateX(-4px);transition:opacity .15s,transform .15s;
        box-shadow:0 8px 20px rgba(14,50,84,.25);
      }
      #railTip.show{opacity:1;transform:translateY(-50%) translateX(0)}
      .rail-badge{
        position:absolute;top:1px;right:1px;min-width:17px;height:17px;border-radius:99px;
        background:var(--gold-deep);color:#fff;font-size:10px;font-weight:800;line-height:1;
        display:grid;place-items:center;padding:0 4px;border:2px solid #fff;font-family:'Plus Jakarta Sans',sans-serif;
      }
      .rail button.active .rail-badge{border-color:var(--navy)}
      .rail-sep{width:26px;height:1px;background:var(--line);margin:5px 0;flex:none}
      .rail .spacer{flex:1;min-height:14px}
      .views{flex:1;min-width:0}
      .view{display:none}
      .view.active{display:block;animation:viewIn .25s ease}
      @keyframes viewIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
      .grid{
        display:grid;gap:18px;
        grid-template-columns:296px minmax(0,1fr) 296px;
        grid-template-areas:"left chart right" "history history right";
      }
      .col-left{grid-area:left;display:flex;flex-direction:column;gap:18px;min-width:0}
      .col-right{grid-area:right;display:flex;flex-direction:column;gap:18px;min-width:0}
      .chart-card{grid-area:chart}
      .history-card{grid-area:history}
      .card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px}
      .card-head{display:flex;align-items:flex-start;gap:10px;margin-bottom:14px}
      .card-head .h-ico{
        width:34px;height:34px;border-radius:10px;background:#F1F3F4;display:grid;place-items:center;color:var(--navy);flex:none;
      }
      .card-head h2{font-size:15px;font-weight:700;margin:0;color:var(--ink)}
      .card-head p{margin:2px 0 0;font-size:12px;color:var(--muted)}
      .expand-btn{margin-left:auto;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;color:#8A97A3;flex:none}
      .expand-btn:hover{background:#EEF3F7;color:var(--navy)}

      /* ---------- View scaffolding ---------- */
      .page-head{display:flex;align-items:flex-start;gap:14px;flex-wrap:wrap;margin:2px 2px 18px}
      .page-head h1{font-size:24px;margin:0;color:var(--ink);letter-spacing:-.2px}
      .page-head p{margin:4px 0 0;font-size:13px;color:var(--muted)}
      .page-head .spacer{flex:1}
      .btn-gold{
        display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--navy);
        border-radius:999px;padding:10px 18px;font-size:13.5px;font-weight:700;min-height:42px;
        font-family:'Plus Jakarta Sans',sans-serif;box-shadow:0 8px 18px rgba(212,180,117,.35);transition:background .15s;
      }
      .btn-gold:hover{background:var(--gold-deep);color:#fff}
      .btn-outline{
        display:inline-flex;align-items:center;gap:8px;background:var(--card);color:var(--navy);
        border:1.5px solid var(--line);border-radius:999px;padding:10px 18px;font-size:13.5px;font-weight:600;min-height:42px;transition:border-color .15s,background .15s;
      }
      .btn-outline:hover{border-color:var(--gold-deep);background:#FBF8F0}
      .btn-sm{min-height:36px;padding:7px 14px;font-size:12.5px}
      .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
      .grid-2:last-child{margin-bottom:0}
      .note-demo{
        font-size:12.5px;color:var(--gold-dark);background:var(--cream);
        border:1.5px dashed var(--gold-deep);border-radius:14px;padding:10px 14px;margin-bottom:18px;line-height:1.5;
      }
      .foot-note{text-align:center;color:var(--muted);font-size:12px;margin:22px 0 2px}

      /* ---------- Tables in views ---------- */
      .table-tools{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px}
      .table-tools h2{font-size:15px;margin:0}
      .chips{display:flex;gap:7px;flex-wrap:wrap}
      .chip{
        border:1.5px solid var(--line);background:var(--card);color:#5B6B78;border-radius:999px;
        padding:6px 14px;font-size:12.5px;font-weight:600;min-height:34px;transition:all .15s;
      }
      .chip:hover{color:var(--navy);border-color:var(--gold-deep)}
      .chip.on{background:var(--navy);border-color:var(--navy);color:#fff}
      .mini-search{
        margin-left:auto;display:flex;align-items:center;gap:7px;background:#F1F3F4;border-radius:999px;padding:0 13px;min-height:38px;color:#8A97A3;
      }
      .mini-search input{border:none;outline:none;background:transparent;font-family:inherit;font-size:13px;color:var(--ink);width:170px;min-height:36px}
      .tbl-scroll{overflow-x:auto}
      .tbl{min-width:700px}
      .badge{
        display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;
        border-radius:999px;padding:4px 11px;white-space:nowrap;
      }
      .badge::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;flex:none}
      .b-live{background:var(--green-bg);color:var(--green)}
      .b-draft{background:#EDF0F2;color:#52657C}
      .b-done{background:#F1F3F4;color:var(--muted)}
      .b-wait{background:var(--cream);color:var(--gold-dark)}
      .b-refund{background:var(--red-bg);color:var(--red)}
      .b-sky{background:#E6F2F8;color:var(--blue)}
      .mini-btn{
        border:1.5px solid var(--line);background:var(--card);color:#5B6B78;border-radius:9px;
        padding:5px 11px;font-size:12.5px;font-weight:600;min-height:32px;transition:all .15s;white-space:nowrap;
      }
      .mini-btn:hover{color:var(--navy);border-color:var(--gold-deep)}
      .mini-btn.warn:hover{color:var(--gold-dark);border-color:var(--gold-deep);background:var(--cream)}
      .mini-btn:disabled{opacity:.45;cursor:not-allowed}
      .row-actions{display:flex;gap:6px;flex-wrap:wrap}
      .progress{height:7px;border-radius:99px;background:#EDF1F3;margin-top:6px;overflow:hidden}
      .progress i{display:block;height:100%;border-radius:99px;background:var(--gold-deep)}
      .mini-progress b{font-family:'Plus Jakarta Sans',sans-serif}
      .mini-progress small{color:var(--muted)}

      /* ---------- Forms ---------- */
      .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
      .form-grid .field{margin-bottom:0}
      .field.full{grid-column:1/-1}
      .field textarea{
        width:100%;border:1.5px solid var(--line);border-radius:12px;padding:10px 13px;font-size:14px;
        font-family:inherit;color:var(--ink);background:#FBFCFD;outline:none;resize:vertical;
      }
      .field textarea:focus{border-color:var(--blue)}
      .field input[type="color"].color-inp{padding:4px 8px;height:44px;cursor:pointer}
      .field input[type="file"].file-inp{padding:8px 13px;font-size:13px}
      .img-prev{display:none;margin-top:9px}
      .img-prev img{max-width:100%;max-height:150px;border-radius:12px;display:block}
      .switch-row{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}
      .switch-row:last-child{border-bottom:0}
      .switch-row .txt{flex:1;min-width:0}
      .switch-row .txt b{font-size:14px;display:block}
      .switch-row .txt span{font-size:12.5px;color:var(--muted)}
      .switch{position:relative;width:46px;height:26px;flex:none;display:inline-block}
      .switch input{position:absolute;opacity:0;width:100%;height:100%;cursor:pointer;margin:0;z-index:2}
      .switch .tr{position:absolute;inset:0;background:#E3E8EC;border:1px solid var(--line);border-radius:99px;transition:.2s;pointer-events:none}
      .switch .tr::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(14,50,84,.25);transition:.2s}
      .switch input:checked + .tr{background:var(--gold-deep);border-color:var(--gold-deep)}
      .switch input:checked + .tr::after{left:22px;background:var(--navy)}

      /* ---------- KPI / keuangan ---------- */
      .kpi-top{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--muted)}
      .kpi-ic{width:32px;height:32px;border-radius:10px;background:var(--cream);color:var(--gold-deep);display:grid;place-items:center;flex:none}
      .kpi-val{font-family:'Plus Jakarta Sans',sans-serif;font-size:25px;font-weight:800;color:var(--ink);margin:10px 0 4px}
      .kpi-delta{font-size:12.5px;color:var(--muted)}
      .kpi-delta.up{color:var(--green);font-weight:600}
      .kpi-delta.up span{color:var(--muted);font-weight:400}
      .fin-grid{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:18px;margin-bottom:18px;align-items:start}
      .fin-saldo{
        border-radius:18px;color:#fff;position:relative;overflow:hidden;
        background:linear-gradient(120deg,var(--navy-2) 0%,var(--navy) 62%,#0A2745 100%);padding:22px;
      }
      .fin-saldo::after{content:"";position:absolute;right:-46px;top:-46px;width:150px;height:150px;border-radius:50%;background:radial-gradient(circle,rgba(234,212,162,.30),rgba(234,212,162,0) 70%)}
      .fin-saldo .lbl{font-size:12px;letter-spacing:.6px;color:#B9CFE2;font-weight:600;position:relative;z-index:1}
      .fin-saldo .val{font-family:'Plus Jakarta Sans',sans-serif;font-size:28px;font-weight:800;margin:6px 0;position:relative;z-index:1}
      .fin-saldo .sub{font-size:12.5px;color:#B9CFE2;margin-bottom:16px;position:relative;z-index:1}
      .fin-saldo .btn-gold{position:relative;z-index:1}

      /* ---------- Check-in ---------- */
      .scan-row{display:flex;gap:9px;flex-wrap:wrap}
      .scan-row input{
        flex:1;min-width:170px;border:1.5px solid var(--line);border-radius:12px;padding:10px 13px;
        font-size:14px;font-family:inherit;color:var(--ink);background:#FBFCFD;outline:none;min-height:44px;
      }
      .scan-row input:focus{border-color:var(--blue)}
      .scan-row .btn-navy,.scan-row .btn-ghost{border-radius:12px;flex:none}
      .scan-row .btn-ghost{border:1.5px solid var(--line)}
      .res-box{border-radius:14px;padding:15px 17px;margin-top:16px;display:none}
      .res-box.show{display:block}
      .res-box b{font-family:'Plus Jakarta Sans',sans-serif;font-size:17px;display:block}
      .res-box p{margin:4px 0 0;font-size:13px;color:var(--ink)}
      .res-valid{background:var(--green-bg);color:var(--green)}
      .res-used{background:var(--cream);color:var(--gold-dark)}
      .res-invalid{background:var(--red-bg);color:var(--red)}
      .stat-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
      .stat-box{background:#F7F9FA;border-radius:14px;padding:13px 10px;text-align:center}
      .stat-box b{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;display:block;color:var(--navy)}
      .stat-box span{font-size:11.5px;color:var(--muted)}

      /* ---------- Kategori / Kota cards ---------- */
      .cat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:16px}
      .cat-card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column}
      .cat-media{height:92px;display:grid;place-items:center;color:#fff;position:relative;overflow:hidden}
      .cat-media svg{width:36px;height:36px}
      .cat-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
      .cat-media .lm{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;text-align:center;padding:0 14px;text-shadow:0 1px 6px rgba(0,0,0,.25)}
      .cat-body{padding:15px 16px 16px;display:flex;flex-direction:column;flex:1}
      .cat-body h3{margin:0 0 4px;font-size:15px}
      .cat-body p{margin:0;font-size:12.5px;color:var(--muted);line-height:1.5}
      .card-actions{display:flex;gap:7px;margin-top:13px}

      /* ---------- Banner slides ---------- */
      .slide-prev{border-radius:16px;padding:20px 22px;color:#fff;position:relative;overflow:hidden;min-height:118px;display:flex;flex-direction:column;justify-content:center;background-size:cover;background-position:center}
      .slide-prev::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,18,34,.45),transparent 70%)}
      .slide-prev h3{margin:0 0 4px;font-size:20px;position:relative;z-index:1}
      .slide-prev p{margin:0 0 12px;font-size:13.5px;color:#D9E6F2;position:relative;z-index:1}
      .pv-cta{position:relative;z-index:1;align-self:flex-start;background:var(--gold);color:var(--navy);font-weight:700;font-size:13px;border-radius:9px;padding:7px 14px;font-family:'Plus Jakarta Sans',sans-serif}

      /* ---------- Tampilan homepage ---------- */
      .spot-box{background:linear-gradient(120deg,var(--navy-2),var(--navy));color:#fff;border-radius:var(--radius);padding:20px 22px;box-shadow:var(--shadow)}
      .spot-box h2{margin:0 0 4px;font-size:17px;color:#fff}
      .spot-box p{margin:0;color:#9FB3C8;font-size:13px;line-height:1.55}
      .spot-badge{background:var(--gold);color:var(--navy);font-size:11px;font-weight:800;border-radius:999px;padding:3px 10px;letter-spacing:.04em;white-space:nowrap}
      .spot-count{font-family:'Plus Jakarta Sans',sans-serif;font-size:25px;font-weight:800;color:var(--gold)}
      .spot-box select{border:1px solid rgba(255,255,255,.3);background:var(--navy);color:#fff;border-radius:12px;padding:9px 12px;font-family:inherit;font-size:14px;max-width:100%;min-height:42px}
      .ord-row{display:flex;align-items:center;gap:11px;padding:10px 12px;border:1.5px solid var(--line);border-radius:14px;margin-bottom:9px;background:var(--card);flex-wrap:wrap}
      .ord-row[draggable="true"]{cursor:grab}
      .ord-row.drag-over{border-color:var(--gold-deep);box-shadow:0 0 0 2px var(--gold)}
      .ord-row .pos{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;color:#B4BFC8;width:20px;text-align:center;flex:none}
      .ord-btns{display:flex;gap:5px;margin-left:auto}

      /* ---------- E-Tiket ---------- */
      .eticket{display:flex;border-radius:18px;overflow:hidden;box-shadow:var(--shadow);max-width:640px;margin:0 auto;background:var(--card)}
      .et-main{flex:1;padding:22px;color:#fff;position:relative;min-width:0}
      .et-main .et-logo{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;letter-spacing:.05em;font-size:14px}
      .et-main h3{margin:12px 0 4px;font-size:20px;line-height:1.25}
      .et-main p{margin:0;font-size:13px;color:#D9E6F2}
      .et-meta{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px;margin-top:16px;font-size:13px}
      .et-meta small{display:block;color:#9FB3C8;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px}
      .et-note{margin-top:16px;font-size:12px;color:#D9E6F2;border-top:1px dashed rgba(255,255,255,.3);padding-top:10px;line-height:1.55}
      .et-stub{width:158px;flex:none;background:var(--card);border-left:2px dashed var(--line);padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px;justify-content:center}
      .et-stub .code{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;letter-spacing:.05em;color:var(--navy)}
      .et-stub small{color:var(--muted);font-size:11.5px;line-height:1.45}

      /* ---------- Analitik / log / promosi ---------- */
      .kw-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}
      .kw-row:last-child{border-bottom:0}
      .kw-rank{width:26px;height:26px;border-radius:50%;background:var(--cream);color:var(--gold-dark);font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:12.5px;display:grid;place-items:center;flex:none}
      .hbar-row{display:grid;grid-template-columns:104px 1fr 60px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px}
      .hbar-row:last-child{border-bottom:0}
      .hbar-track{height:11px;background:#EDF1F3;border-radius:99px;overflow:hidden}
      .hbar-fill{height:100%;border-radius:99px;background:var(--navy-2)}
      .hbar-row b{text-align:right;font-family:'Plus Jakarta Sans',sans-serif}
      .log-row{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);align-items:flex-start}
      .log-row:last-child{border-bottom:0}
      .log-row p{margin:0;font-size:13.5px;line-height:1.5}
      .log-row small{color:var(--muted);font-size:12px}
      .log-ava{width:36px;height:36px;border-radius:50%;background:#E6F2F8;color:var(--blue);display:grid;place-items:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:12px;flex:none}
      .promo-row{display:flex;align-items:center;gap:14px;padding:15px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
      .promo-row:last-child{border-bottom:0}
      .promo-code{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;letter-spacing:.05em;background:var(--cream);color:var(--gold-dark);border:1.5px dashed var(--gold-deep);border-radius:10px;padding:7px 14px;font-size:14px;white-space:nowrap}
      .promo-info{flex:1;min-width:200px}
      .promo-info b{font-size:14px}
      .promo-info p{margin:2px 0 0;font-size:12.5px;color:var(--muted)}
      .tx-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}
      .tx-row:last-child{border-bottom:0}
      .tx-ic{width:36px;height:36px;border-radius:11px;background:var(--cream);color:var(--gold-deep);display:grid;place-items:center;flex:none}
      .tx-main{flex:1;min-width:0}
      .tx-name{font-weight:600;font-size:13.5px}
      .tx-sub{font-size:12px;color:var(--muted);margin-top:1px}
      .tx-amt{text-align:right;font-weight:700;font-size:13.5px;font-family:'Plus Jakarta Sans',sans-serif}
      .tx-amt small{display:block;color:var(--muted);font-weight:500;font-family:'Inter',sans-serif;font-size:11.5px;margin-top:1px}
      .best-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}
      .best-row:last-child{border-bottom:0}
      .best-thumb{width:42px;height:42px;border-radius:12px;color:#fff;display:grid;place-items:center;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;flex:none}
      .best-info{flex:1;min-width:0}
      .best-name{font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .best-meta{font-size:12px;color:var(--muted);margin-top:1px}
      .best-pct{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:var(--navy);text-align:right}
      .best-pct small{display:block;font-size:10.5px;color:var(--muted);font-weight:500;font-family:'Inter',sans-serif}
      .chart-legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-top:10px}
      .chart-legend b{color:var(--ink)}
      .stock-edit{display:flex;gap:7px;align-items:center}
      .stock-edit input{width:104px;border:1.5px solid var(--line);border-radius:9px;padding:6px 10px;font-size:13px;font-family:inherit;color:var(--ink);background:#FBFCFD;outline:none;min-height:34px}
      .stock-edit input:focus{border-color:var(--blue)}
      .stock-warn{color:var(--gold-dark);font-weight:700;font-size:12px;white-space:nowrap}

      /* ---------- Detail modal list ---------- */
      .detail-list{display:grid;grid-template-columns:118px 1fr;gap:9px 14px;margin:0;font-size:13.5px}
      .detail-list dt{color:var(--muted);font-weight:500}
      .detail-list dd{margin:0;font-weight:600;color:var(--ink)}
      .detail-total{display:flex;justify-content:space-between;align-items:center;border-top:1.5px dashed var(--line);margin-top:16px;padding-top:14px;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;color:var(--navy)}

      /* ---------- Pratinjau homepage ---------- */
      .pv{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff}
      .pv-nav{background:var(--navy);color:#fff;padding:12px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:13px}
      .pv-nav b{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:.02em}
      .pv-nav b em{font-style:normal;color:var(--gold)}
      .pv-sec{padding:16px 18px 4px}
      .pv-sec h4{margin:0 0 10px;font-size:14px;font-family:'Plus Jakarta Sans',sans-serif;color:var(--navy)}
      .pv-chips,.pv-city{display:flex;gap:8px;flex-wrap:wrap;padding-bottom:14px}
      .pv-chip{border:1.5px solid var(--line);border-radius:999px;padding:5px 13px;font-size:12.5px;font-weight:600;color:var(--navy);background:#fff}
      .pv-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:10px;padding-bottom:14px}
      .pv-card{border:1px solid var(--line);border-radius:12px;overflow:hidden}
      .pv-card .ph{height:64px;display:grid;place-items:center;color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;position:relative}
      .pv-card .pb{padding:8px 10px}
      .pv-card .pb b{display:block;font-size:12px;line-height:1.35}
      .pv-card .pb span{font-size:11px;color:var(--muted)}
      .pv-pop{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--line);font-size:13px;flex-wrap:wrap}
      .pv-pop:last-child{border-bottom:0}

      /* ---------- Ticket card (ringkasan) ---------- */
      .ticket{
        border-radius:18px;color:#fff;position:relative;overflow:hidden;
        background:linear-gradient(120deg,var(--navy-2) 0%,var(--navy) 62%,#0A2745 100%);
        padding:18px 18px 16px;
      }
      .ticket::after{
        content:"";position:absolute;right:-46px;top:-46px;width:150px;height:150px;border-radius:50%;
        background:radial-gradient(circle,rgba(234,212,162,.30),rgba(234,212,162,0) 70%);
      }
      .ticket-top{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}
      .ticket-brand{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:16px;letter-spacing:.4px}
      .ticket-brand em{font-style:normal;color:var(--gold)}
      .ticket-sub{font-size:11px;color:#B9CFE2;margin-top:2px;letter-spacing:.3px}
      .ticket-amount{font-family:'Plus Jakarta Sans',sans-serif;font-size:27px;font-weight:800;margin:16px 0 14px;position:relative;z-index:1;letter-spacing:.2px}
      .ticket-amount small{display:block;font-family:'Inter',sans-serif;font-size:11px;font-weight:500;color:#B9CFE2;margin-bottom:5px;letter-spacing:.4px}
      .ticket-meta{display:flex;justify-content:space-between;align-items:flex-end;font-size:12px;color:#D7E4EF;position:relative;z-index:1}
      .ticket-meta .num{letter-spacing:2.5px;font-weight:600}
      .ticket-meta .exp{text-align:right}
      .ticket-meta .exp span{display:block;font-size:9.5px;color:#93AEC6;letter-spacing:1.2px}
      .perf{display:flex;gap:5px;margin-top:14px;position:relative;z-index:1}
      .perf i{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.35)}
      .weekly{display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:15px;border-top:1px solid var(--line)}
      .weekly p{margin:0;font-size:12.5px;color:var(--muted)}
      .weekly strong{display:block;font-family:'Plus Jakarta Sans',sans-serif;font-size:19px;color:var(--ink);margin-top:2px}
      .badge-pct{
        margin-left:auto;background:var(--green-bg);color:var(--green);font-size:12px;font-weight:700;
        padding:5px 11px;border-radius:999px;white-space:nowrap;
      }

      /* ---------- Bar chart (ringkasan) ---------- */
      .seg{display:flex;background:#F1F3F4;border-radius:999px;padding:3px;gap:2px}
      .seg button{padding:6px 14px;border-radius:999px;font-size:12px;font-weight:600;color:#5B6B78;min-height:32px}
      .seg button.active{background:var(--navy);color:#fff;box-shadow:0 4px 10px rgba(14,50,84,.25)}
      .chart-area{display:flex;gap:8px;margin-top:8px;padding-top:36px}
      .y-axis{display:flex;flex-direction:column;justify-content:space-between;height:218px;padding:2px 0 24px;font-size:11px;color:var(--muted);text-align:right;width:30px;flex:none}
      .bars{flex:1;display:flex;align-items:flex-end;gap:6px;height:218px;border-bottom:1px solid var(--line);position:relative}
      .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;position:relative}
      .bar{
        width:min(52px,72%);border-radius:999px 999px 10px 10px;background:var(--bar);
        transition:height .6s cubic-bezier(.22,.8,.3,1);position:relative;min-height:8px;
      }
      .bar-col:nth-child(odd) .bar{background:var(--bar-soft)}
      .bar-col.hot .bar{
        background:repeating-linear-gradient(45deg,var(--navy) 0 7px,#123f66 7px 14px);
      }
      .bar .tip{
        position:absolute;bottom:calc(100% + 13px);left:50%;transform:translateX(-50%);
        background:var(--navy);color:var(--gold);font-size:11px;font-weight:700;
        padding:4px 9px;border-radius:999px;white-space:nowrap;display:none;
      }
      .bar-col.hot .tip{display:block}
      .bar .tip::after{
        content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);
        width:9px;height:9px;border-radius:50%;background:var(--gold-deep);border:2px solid #fff;
        box-shadow:0 1px 4px rgba(14,50,84,.3);margin-top:3px;
      }
      .bar-labels{display:flex;gap:6px;margin-left:38px;margin-top:9px}
      .bar-labels span{flex:1;text-align:center;font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.6px}
      .bar-labels span.hot{color:var(--navy)}
      .chart-foot{margin-top:14px;font-size:12.5px;color:var(--muted)}
      .chart-foot strong{color:var(--navy)}

      /* ---------- Saldo / area chart ---------- */
      .saldo-label{font-size:12.5px;color:var(--muted);text-align:center}
      .saldo-amount{font-family:'Plus Jakarta Sans',sans-serif;font-size:29px;font-weight:800;text-align:center;color:var(--ink);margin:3px 0 6px}
      .area-chart{width:100%;height:auto;display:block}
      .saldo-actions{display:flex;gap:10px;margin-top:12px}
      .btn-navy{
        flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:var(--navy);color:#fff;
        border-radius:999px;padding:10px;font-size:13px;font-weight:700;min-height:42px;
        font-family:'Plus Jakarta Sans',sans-serif;transition:background .15s;
      }
      .btn-navy:hover{background:var(--navy-2)}
      .btn-ghost{
        flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:transparent;color:var(--navy);
        border-radius:999px;padding:10px;font-size:13px;font-weight:600;min-height:42px;transition:background .15s;
      }
      .btn-ghost:hover{background:#EEF3F7}
      .big-amount{font-family:'Plus Jakarta Sans',sans-serif;font-size:27px;font-weight:800;color:var(--ink)}
      .sub-card{border-top:1px solid var(--line);margin-top:16px;padding-top:15px}
      .sub-head{display:flex;align-items:flex-start;gap:8px}
      .sub-head h3{font-size:13.5px;margin:0}
      .sub-head p{margin:2px 0 0;font-size:11.5px;color:var(--muted)}
      .ava-stack{display:flex;align-items:center;margin-top:13px}
      .ava{
        width:40px;height:40px;border-radius:50%;border:2.5px solid #fff;display:grid;place-items:center;
        font-size:12px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;color:#fff;margin-left:-9px;
      }
      .ava:first-child{margin-left:0}
      .ava.more{background:var(--navy);color:var(--gold);font-size:12.5px}

      /* ---------- History table (ringkasan) ---------- */
      table{width:100%;border-collapse:collapse}
      thead th{
        text-align:left;font-size:11.5px;font-weight:600;color:var(--muted);letter-spacing:.4px;
        padding:4px 10px 10px;border-bottom:1px solid var(--line);white-space:nowrap;
      }
      thead th:last-child,tbody td:last-child{text-align:right}
      tbody td{padding:13px 10px;border-bottom:1px solid #F0F2F4;font-size:13.5px;vertical-align:middle;white-space:nowrap}
      tbody tr:last-child td{border-bottom:none}
      .ev-cell{display:flex;align-items:center;gap:11px;white-space:normal}
      .ev-ava{
        width:38px;height:38px;border-radius:50%;flex:none;display:grid;place-items:center;color:#fff;
        font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;
      }
      .ev-thumb{
        width:42px;height:42px;border-radius:12px;flex:none;display:grid;place-items:center;color:#fff;
        font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:13px;
      }
      .ev-name{font-weight:600;color:var(--ink);font-size:13.5px}
      .ev-sub{font-size:11.5px;color:var(--muted);font-weight:500;margin-top:1px}
      .status{display:inline-flex;align-items:center;gap:7px;font-weight:500}
      .status i{width:7px;height:7px;border-radius:50%;background:var(--green);flex:none}
      .amount{font-weight:700;color:var(--ink)}
      .empty-row td{text-align:center;color:var(--muted);padding:26px 10px;white-space:normal}

      /* ---------- Modal & toast ---------- */
      .overlay{
        position:fixed;inset:0;background:rgba(14,50,84,.45);backdrop-filter:blur(3px);
        display:none;place-items:center;z-index:100;padding:18px;overflow-y:auto;
      }
      .overlay.open{display:grid}
      .modal{background:#fff;border-radius:24px;max-width:460px;width:100%;padding:26px;box-shadow:0 30px 70px rgba(14,50,84,.3);position:relative;margin:auto}
      .modal.wide{max-width:880px}
      .modal h2{margin:0 0 4px;font-size:19px;color:var(--navy);padding-right:34px}
      .modal>p{margin:0 0 18px;font-size:13px;color:var(--muted);line-height:1.55}
      .modal-x{
        position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:50%;
        display:grid;place-items:center;color:#8A97A3;font-size:15px;
      }
      .modal-x:hover{background:#EEF3F7;color:var(--navy)}
      .field{margin-bottom:13px}
      .field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--ink)}
      .field input,.field select{
        width:100%;border:1.5px solid var(--line);border-radius:12px;padding:10px 13px;font-size:14px;
        font-family:inherit;color:var(--ink);background:#FBFCFD;min-height:44px;outline:none;
      }
      .field input:focus,.field select:focus{border-color:var(--blue)}
      .modal-actions{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap}
      .modal-actions .btn-navy,.modal-actions .btn-ghost{border-radius:12px}
      .modal-actions .btn-ghost{border:1.5px solid var(--line)}
      .btn-danger{
        display:inline-flex;align-items:center;justify-content:center;gap:7px;background:var(--red);color:#fff;
        border-radius:12px;padding:10px 18px;font-size:13px;font-weight:700;min-height:42px;font-family:'Plus Jakarta Sans',sans-serif;
      }
      .toast{
        position:fixed;left:50%;bottom:26px;transform:translate(-50%,80px);z-index:120;
        background:var(--navy);color:#fff;font-size:13.5px;font-weight:600;
        padding:13px 22px;border-radius:999px;box-shadow:0 16px 36px rgba(14,50,84,.35);
        transition:transform .35s cubic-bezier(.22,.8,.3,1);max-width:calc(100vw - 32px);text-align:center;
      }
      .toast.show{transform:translate(-50%,0)}
      .toast em{font-style:normal;color:var(--gold)}

      /* ---------- Responsive ---------- */
      @media (max-width:1120px){
        .grid{grid-template-columns:270px minmax(0,1fr);grid-template-areas:"left chart" "right right" "history history"}
        .col-right{flex-direction:row}
        .col-right>.card{flex:1}
        .fin-grid{grid-template-columns:1fr 1fr}
        .fin-saldo{grid-column:1/-1}
      }
      @media (max-width:900px){
        .grid-2{grid-template-columns:1fr}
      }
      @media (max-width:820px){
        .topnav{display:none}
        .grid{grid-template-columns:minmax(0,1fr);grid-template-areas:"left" "chart" "right" "history"}
        .col-right{flex-direction:column}
        .layout{flex-direction:column}
        .rail{
          flex-direction:row;flex-wrap:wrap;width:100%;border-radius:22px;padding:10px 12px;
          position:static;max-height:none;overflow:visible;justify-content:flex-start;gap:6px;
        }
        .rail .spacer{display:none}
        .rail-sep{display:none}
        .rail button{width:42px;height:42px}
        #railTip{display:none}
        .fin-grid{grid-template-columns:1fr}
      }
      @media (max-width:640px){
        body{padding:12px 8px 20px}
        .frame{padding:12px 12px 16px;border-radius:22px}
        .topbar{padding:8px 8px 8px 14px}
        .logo-ticket{height:34px}
        .logo-word{font-size:17px}
        .greet{margin:18px 2px 14px}
        .greet-actions{margin-left:0;width:100%}
        .range-wrap{flex:1}
        .range-btn{width:100%;justify-content:center}
        .btn-primary{flex:1;justify-content:center}
        .search-wrap.open .search-input{width:110px}
        .form-grid{grid-template-columns:1fr}
        .tbl{min-width:0}
        .tbl-scroll{overflow-x:visible}
        .eticket{flex-direction:column}
        .et-stub{width:100%;border-left:0;border-top:2px dashed var(--line)}
        .mini-search{margin-left:0;width:100%}
        .mini-search input{width:100%}
        thead{display:none}
        table,tbody,tr,td{display:block;width:100%}
        tbody tr{padding:12px 2px;border-bottom:1px solid var(--line)}
        tbody tr:last-child{border-bottom:none}
        tbody td{border:none;padding:3px 2px;white-space:normal}
        tbody td::before{
          content:attr(data-label);display:block;font-size:10.5px;font-weight:600;color:var(--muted);
          letter-spacing:.5px;text-transform:uppercase;margin-bottom:1px;
        }
        tbody td:last-child{text-align:left}
        .ev-cell{padding-bottom:4px}
        .ev-cell::before{display:none}
        .empty-row td::before{display:none}
        td.no-label::before{display:none}
      }
      @media (prefers-reduced-motion:reduce){
