      function qrSVG(code){
        var seed = 0; for(var i = 0; i < code.length; i++){ seed = (seed * 31 + code.charCodeAt(i)) >>> 0; }
        function rnd(){ seed = (seed * 1103515245 + 12345) >>> 0; return (seed >> 16) & 1; }
        var n = 21, cell = 6, out = "";
        function finder(x, y){ return '<rect x="' + x * cell + '" y="' + y * cell + '" width="' + 7 * cell + '" height="' + 7 * cell + '" fill="#0E3254"/><rect x="' + (x + 1) * cell + '" y="' + (y + 1) * cell + '" width="' + 5 * cell + '" height="' + 5 * cell + '" fill="#fff"/><rect x="' + (x + 2) * cell + '" y="' + (y + 2) * cell + '" width="' + 3 * cell + '" height="' + 3 * cell + '" fill="#0E3254"/>'; }
        for(var y = 0; y < n; y++) for(var x = 0; x < n; x++){
          var inF = (x < 8 && y < 8) || (x > n - 9 && y < 8) || (x < 8 && y > n - 9);
          if(!inF && rnd()) out += '<rect x="' + x * cell + '" y="' + y * cell + '" width="' + cell + '" height="' + cell + '" fill="#0E3254"/>';
        }
        return '<svg width="104" height="104" viewBox="0 0 ' + (n * cell) + ' ' + (n * cell) + '" role="img" aria-label="QR tiket ' + esc(code) + '" style="background:#fff;border-radius:6px">' + out + finder(0, 0) + finder(n - 7, 0) + finder(0, n - 7) + '</svg>';
