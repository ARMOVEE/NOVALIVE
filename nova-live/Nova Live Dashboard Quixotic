        }).join("") || '<p style="color:var(--muted);font-size:13px">Belum ada notifikasi terkirim.</p>';
      }
      $("#notifForm").addEventListener("submit", function(e){
        e.preventDefault();
        var n = {title:$("#nfTitle").value.trim(), msg:$("#nfMsg").value.trim(), target:targetName(), when:"17 Nov 2026, " + nowTime().replace("Hari ini, ", "")};
